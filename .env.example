# ==============================================================================
# PQChat — environment configuration
# ==============================================================================

# ── Required ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/pqchat
# Signs access tokens. The server refuses to start without it; in production it
# must be 32+ characters:  openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
# Origins allowed to open Socket.IO connections (comma-separated).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Number of reverse proxies in front of the app. 0/unset = ignore X-Forwarded-For
# (it is client-controlled). Set to 1 behind a single nginx / load balancer.
TRUST_PROXY=0

# ── Horizontal scaling (optional) ─────────────────────────────────────────────
# With Redis: Socket.IO Redis adapter, shared presence and shared rate limits,
# so any number of app instances can run behind a load balancer.
# REDIS_URL=redis://localhost:6379

# ── Media storage (optional) ──────────────────────────────────────────────────
# Default: encrypted blobs on local disk in UPLOAD_DIR.
# UPLOAD_DIR=./uploads
# MAX_MEDIA_BYTES=26214400
#
# S3-compatible object storage (AWS S3, Cloudflare R2, MinIO). Browsers upload and
# download ciphertext directly via short-lived presigned URLs (configure bucket CORS).
# S3_BUCKET=pqchat-media
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_PUBLIC_ENDPOINT=            # only if browsers reach storage via another host
# S3_FORCE_PATH_STYLE=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
