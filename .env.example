# ==============================================================================
# PQChat - Post-Quantum Secure End-to-End Encrypted Chatting App
# Environment Configuration Template
# ==============================================================================

# 🌐 Database Connection
# MongoDB connection URI (e.g. local instance or MongoDB Atlas cluster)
MONGO_URI=mongodb://localhost:27017/pqchat

# 🔐 Authentication Security (REQUIRED)
# Secret key used for signing JWT session tokens. 
# MUST be set in production to prevent token forgery (fail-closed model).
JWT_SECRET=your_production_jwt_secret_key_here

# 📡 Socket.IO / CORS Domain Security
# Comma-separated list of permitted origins allowed to establish WebSocket connections.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ⚙️ Application Port (Optional - Default: 3000)
PORT=3000
